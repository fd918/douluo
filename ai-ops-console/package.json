{
  "name": "douluo-ai-ops-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "connect:game": "node scripts/connect-game.mjs",
    "disconnect:game": "node scripts/connect-game.mjs --restore",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "lucide-react": "0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.1.3"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2"
  }
}
