# AI 服务端配置示例
# 复制为 .env.local 后再填写真实内容；不要把真实令牌提交到 Git。

# 必须以 /v1 结尾；以下为 Agnes 示例，换供应商时只改这里
AI_BASE_URL=https://apihub.agnes-ai.com/v1

# 服务实际返回的模型 ID；换供应商时同步修改
AI_MODEL_ID=agnes-2.5-flash

# 只允许服务端读取。不要改成 VITE_AI_API_KEY，否则可能被浏览器暴露。
AI_API_KEY=

# 单次生成超时时间，单位毫秒
AI_REQUEST_TIMEOUT_MS=90000

# 可选备用服务。主服务失败、超时或返回无效内容时自动尝试这里。
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL_ID=
AI_FALLBACK_API_KEY=
AI_FALLBACK_REQUEST_TIMEOUT_MS=30000

# 单个访问来源的基础保护；公网发布后可在部署平台调整。
AI_REQUESTS_PER_MINUTE=12
AI_DAILY_REQUEST_LIMIT=120

# 可选：持久化限流来源摘要的加盐值。只放部署平台环境变量，不提交真实值。
# Sites 生产环境使用 .openai/hosting.json 中的 DB（D1）绑定；本机没有 DB 时自动回退内存限流。
AI_RATE_LIMIT_SALT=
