{
  "name": "game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:audio": "node scripts/validate-audio-manifest.mjs",
    "generate:narration": "node --experimental-strip-types scripts/generate-narration-audio.mjs",
    "test:story": "node --experimental-strip-types --test tests/story-content.test.mjs",
    "test:world": "node --experimental-strip-types --test tests/world-director.test.mjs",
    "test:content": "node --experimental-strip-types --test tests/douluo-world-content.test.mjs",
    "test:gameplay": "node --experimental-strip-types --test tests/gameplay-rules.test.mjs",
    "test:browser-ai": "node --experimental-strip-types --test tests/browser-ai.test.mjs",
    "test:sites": "npm run build && node --test tests/sites-worker.test.mjs tests/ai-ops-cloud.test.mjs",
    "verify": "npm run check:runtime && npm run test:audio && npm run test:story && npm run test:content && npm run test:gameplay && npm run test:world && npm run test:browser-ai && npm run test:sites",
    "build:pages": "npm run check:runtime && GITHUB_PAGES=1 tsc && GITHUB_PAGES=1 vite build",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
